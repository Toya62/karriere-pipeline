# Frontend build-time environment (Vite). Copy to .env for local dev.
# Values are baked into the JS bundle at build time — never commit a real .env.

# Google OAuth client ID ("Karriere Web" client under pandey.ramu62@gmail.com).
# Must be set in the CI/build environment too, or Google sign-in is disabled.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
