{
  "name": "karriere-dashboard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vite + TypeScript Jobs view for the Karriere Pipeline dashboard (strangler phase).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:api": "../.venv/bin/python ../scripts/export_openapi.py > openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
