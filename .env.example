# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# GitHub Personal Access Token (for pipeline automation, commits, PRs)
GITHUB_TOKEN=your_github_token_here

# LLM Providers (for job profile matching, CV tailoring, and cover letters)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional backup keys for rotation
# GEMINI_API_KEY_2=your_second_gemini_key
# GEMINI_API_KEY_3=your_third_gemini_key
GROQ_API_KEY=your_groq_api_key_here

# LinkedIn Scraping Cookie (Optional - for authenticated scraping)
LINKEDIN_LI_AT=your_linkedin_li_at_cookie

# WhatsApp Notification via CallMeBot (Optional)
# 1. Add CallMeBot on WhatsApp: +34 941 87 36 25
# 2. Send: "I allow callmebot to send me messages"
# 3. Enter your phone number (international format) and the received API key:
WHATSAPP_PHONE=+491234567890
CALLMEBOT_API_KEY=your_callmebot_api_key_here
