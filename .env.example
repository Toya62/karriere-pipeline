# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# GitHub Personal Access Token (for pipeline automation, commits, PRs)
GITHUB_TOKEN=your_github_token_here

# LLM Providers (for job profile matching, CV tailoring, and cover letters)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional backup keys for rotation
# GEMINI_API_KEY_2=your_second_gemini_key
# GEMINI_API_KEY_3=your_third_gemini_key
GROQ_API_KEY=your_groq_api_key_here

# LinkedIn Scraping Cookie (Optional - for authenticated scraping)
LINKEDIN_LI_AT=your_linkedin_li_at_cookie

# Telegram Bot Notification (Optional)
# 1. Talk to @BotFather on Telegram to create bot and obtain TELEGRAM_BOT_TOKEN
# 2. Start a chat with your bot, then get your chat ID (e.g., via @userinfobot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Cloudflare R2 / AWS S3 Cloud Backups (Optional - 10GB free tier)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=karriere-backups

# Healthchecks.io Heartbeat (Optional - for automated cron monitoring)
HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

# PostgreSQL (Primary Database) — F8: required in multi-user/production mode.
# Local dev may omit it (SQLite fallback at data/karriere.db). Production
# (MULTI_USER_MODE=true or ENV=production) refuses to start without it.
# On the Oracle host, Postgres runs as the `karriere-postgres` container on
# the shared `web-proxy` network; local dev can use 127.0.0.1 instead.
DATABASE_URL=postgresql://karriere_user:change_me@karriere-postgres:5432/karriere_db

# Multi-User SaaS & Authentication (Optional / Defaults provided)
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=43200
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
MULTI_USER_MODE=true
