{
  "manifest_version": 3,
  "name": "Sarathi — AI Career & ATS Auto-Fill",
  "version": "1.0.0",
  "description": "Automated ATS Form Filling, Document Attachment & AI Form Copilot for Greenhouse, Workday, Lever, Personio, Ashby, SmartRecruiters, and job portals.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sarathi ATS Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://karriere-pipeline.duckdns.org/*",
    "https://*.duckdns.org/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}