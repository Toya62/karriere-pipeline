{
  "manifest_version": 3,
  "name": "Sarathi — AI Career & ATS Auto-Fill",
  "version": "1.4.1",
  "description": "Automated ATS Form Filling, Document Attachment & AI Form Copilot for Greenhouse, Workday, Lever, Personio, Ashby, SmartRecruiters, and job portals.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sarathi ATS Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://karriere-pipeline.duckdns.org/*",
    "https://karriere-dev.duckdns.org/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://karriere-pipeline.duckdns.org/*",
        "https://karriere-dev.duckdns.org/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "https://*.greenhouse.io/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.lever.co/*",
        "https://*.jobs.personio.de/*",
        "https://*.personio.de/*",
        "https://*.jobs.personio.com/*",
        "https://*.personio.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.indeed.de/*",
        "https://*.join.com/*",
        "https://*.stepstone.de/*",
        "https://*.workable.com/*",
        "https://*.bamboohr.com/*",
        "https://*.recruitee.com/*",
        "https://*.softgarden.io/*",
        "https://*.softgarden.de/*",
        "https://*.teamtailor.com/*",
        "https://*.breezy.hr/*",
        "https://*.jobvite.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.eu/*",
        "https://*.successfactors.com/*",
        "https://*.jobs2web.com/*",
        "https://*.xing.com/*"
      ],
      "all_frames": true,
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}